# -------------------------------------------------------------
# Production Dockerfile for FAIMESS Backend API Server
# -------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Copy server code and assets
COPY package*.json ./
COPY server ./server
COPY src/assets/audio ./src/assets/audio

EXPOSE 4000

ENV NODE_ENV=production
ENV PORT=4000

HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:4000/api/health || exit 1

CMD ["node", "--experimental-strip-types", "server/server.ts"]
