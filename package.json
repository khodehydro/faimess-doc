{
  "name": "fiplan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FAIMESS — K-pop streaming dashboard (Vite + React + TypeScript + Tailwind v4)",
  "scripts": {
    "dev": "vite",
    "server": "node --experimental-strip-types server/server.ts",
    "start": "node --experimental-strip-types server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run check:ssr",
    "check:ssr": "vite build --ssr tools/ssr-check.tsx --outDir .ssrcheck --emptyOutDir && node .ssrcheck/ssr-check.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource/pretendard": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
